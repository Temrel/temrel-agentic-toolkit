{
  "permissions": {
    "allow": [
      "Bash(curl *)",
      "Bash(jq *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npm test"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo session started"
          }
        ]
      }
    ]
  }
}
